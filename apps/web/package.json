{
  "name": "gigbid-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "playwright test",
    "api:generate": "openapi-typescript ../../docs/openapi.json -o src/lib/api/schema.d.ts && openapi --input ../../docs/openapi.json --output src/lib/api/generated --client fetch"
  },
  "dependencies": {
    "lucide-react": "0.511.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.5"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.15.29",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.6",
    "openapi-typescript": "7.8.0",
    "openapi-typescript-codegen": "0.31.0",
    "typescript": "5.8.3",
    "vite": "6.4.6"
  }
}
